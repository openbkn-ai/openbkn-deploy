# OpenBKN — docker compose 环境变量模板（单机栈，见 README.zh.md）
# 用法：cp .env.example .env && 按需修改，然后 docker compose up -d

# ── 镜像 ─────────────────────────────────────────────────────────────────────
IMAGE_REGISTRY=ghcr.io/openbkn-ai
# 与 release-manifests/<version>/ 对齐；0.2.2 的 chart 已发布但镜像未全部上架，暂留 0.2.1
OPENBKN_VERSION=0.2.1

# ── 对外访问 ─────────────────────────────────────────────────────────────────
# 浏览器 / CLI / OAuth issuer 使用的统一入口（gateway 容器）。
# 换机器访问时改成 http://<host-ip>:8080，必须与浏览器实际地址一致，否则 OAuth 回调失败。
PUBLIC_BASE_URL=http://localhost:8080
GATEWAY_PORT=8080
# bkn-studio（独立前端仓库）的开发回调；不用 Studio 可保留
STUDIO_REDIRECT_URI=http://localhost:8000/studio/callback
CLI_REDIRECT_URI=http://127.0.0.1:9010/callback
# oss-gateway 返回给浏览器/CLI 的 MinIO 地址（必须是客户端可达地址）
OSS_PUBLIC_ENDPOINT=http://localhost:9000
# 单副本可留空；多副本时用于跨实例校验加密游标
BKN_QUERY_CURSOR_KEY=

# ── 凭据（默认值仅用于本地/内网，生产必须改）─────────────────────────────────
MARIADB_ROOT_PASSWORD=openbkn
OPENSEARCH_PASSWORD=OpenBKN_Admin123!
HYDRA_POSTGRES_PASSWORD=hydra
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Kafka 容器内 SASL_PLAINTEXT 账号（sandbox_network 内客户端必用）
KAFKA_SASL_PASSWORD=openbkn-kafka
HYDRA_SECRETS_SYSTEM=change-me-please-48-characters-minimum-0123456789
# bkn-safe 首次启动创建的管理员初始密码；留空则由 bkn-safe 随机生成并打印一次
BKN_SAFE_INITIAL_PASSWORD=111111
# bkn-safe 许可证实例标识；留空则自动使用容器内身份（本地部署可不激活）
OPENBKN_INSTANCE_ID=
# bkn-agent provenance bootstrap token
BKN_AGENT_PROVENANCE_TOKEN=change-me-bkn-agent-provenance-token
# oss-gateway-backend AES key（32 字节）
OSS_GATEWAY_AES_KEY=k8WVs8pfQae0LhUgevDvPXiYPqYZ8HRM
# BKN Trace evidence ingest token（仅 trace profile 使用）
TRACE_EVIDENCE_INGEST_TOKEN=change-me-trace-evidence-token
# agent-observability 游标签名 key（留空表示不签名）
BKN_OBSERVABILITY_CURSOR_SIGNING_KEY=

# ── 可选：中间件对外端口（调试用；仅绑定 127.0.0.1）─────────────────────────
MARIADB_HOST_PORT=13306
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
OPENSEARCH_HOST_PORT=19200
# 宿主 19092 映射容器内 PLAINTEXT 9092（调试用；SASL 19092 不对外）
KAFKA_HOST_PORT=19092
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
# 仅 trace 栈使用
TRACE_HTTP_HOST_PORT=18080
OTLP_GRPC_HOST_PORT=14317
OTLP_HTTP_HOST_PORT=14318

# ── 可选：资源限制 ───────────────────────────────────────────────────────────
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
