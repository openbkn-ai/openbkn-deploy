# data-migrator 依赖服务连接配置模板。
# 容器启动时由 init/render-secret-config.py 用环境变量渲染为
# /etc/data-migrator/secret-config.yaml，避免把密码写进仓库。
depServices:
  rds:
    source_type: internal
    type: mariadb
    host: "${DB_HOST}"
    port: ${DB_PORT}
    user: "${DB_USER}"
    password: "${DB_PASSWORD}"
    hostRead: "${DB_HOST_READ}"
    portRead: ${DB_PORT_READ}
    admin_key: ""
    mgmt_host: ""
    mgmt_port: 8888

  mongodb: {}

  opensearch:
    host: "${OPENSEARCH_HOST}"
    port: ${OPENSEARCH_PORT}
    protocol: "${OPENSEARCH_PROTOCOL}"
    user: "${OPENSEARCH_USER}"
    password: "${OPENSEARCH_PASSWORD}"

  redis:
    connectType: standalone
    connectInfo:
      host: "${REDIS_HOST}"
      port: ${REDIS_PORT}
      username: ""
      password: "${REDIS_PASSWORD}"
      masterHost: ""
      masterPort: 0
      slaveHost: ""
      slavePort: 0
      sentinelHost: ""
      sentinelPort: 0
      sentinelUsername: ""
      sentinelPassword: ""
      masterGroupName: ""
